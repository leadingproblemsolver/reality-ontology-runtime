{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "settlement_receipt.schema.json",
  "title": "SettlementReceipt",
  "type": "object",
  "required": [
    "run_id",
    "prior_state",
    "action_taken",
    "observed_result",
    "evidence",
    "new_state",
    "next_transition",
    "owner",
    "context_updated"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "prior_state": {},
    "action_taken": {},
    "observed_result": {},
    "evidence": {
      "type": "array"
    },
    "new_state": {},
    "unresolved": {
      "type": "array"
    },
    "waiting_external": {
      "type": "array"
    },
    "next_transition": {},
    "next_action": {},
    "owner": {},
    "do_not_repeat": {
      "type": "array"
    },
    "context_updated": {
      "const": true
    }
  },
  "additionalProperties": true
}
