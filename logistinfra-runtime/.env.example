# GitHub API access for issue acquisition (read-only scope is sufficient)
GITHUB_TOKEN=

# Supabase project holding the logistinfra-runtime tables (dedicated project, not shared)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider used only for bounded relevance scoring (see src/adapters/llm.ts)
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# Provider-independent worker plane.
# Configure any subset; Logistinfra resolves capabilities across registered workers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
